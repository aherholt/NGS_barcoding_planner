# Copy to .env and fill in. NEVER commit .env (it contains passwords).

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_HTTPS=1
DJANGO_ALLOWED_HOSTS=planner.lab.local,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://planner.lab.local

# --- Database (docker-compose sets POSTGRES_DB/USER/HOST) ---
POSTGRES_PASSWORD=change-me

# --- Optional: Microsoft Entra ID login (docs/SETUP_ENTRA_ID.md) ---
# ENTRA_TENANT_ID=
# OIDC_RP_CLIENT_ID=
# OIDC_RP_CLIENT_SECRET=

# --- Optional: SharePoint sync (docs/SHAREPOINT_SYNC.md) ---
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# SHAREPOINT_SITE_ID=
# SHAREPOINT_LIST_ID=

# --- Planner defaults (optional) ---
# PLANNER_MIN_HAMMING=3
# PLANNER_PHIX_PERCENT=1
# PLANNER_LOW_COMPLEXITY_PHIX_PERCENT=10
# PLANNER_SAFETY_MARGIN=10
